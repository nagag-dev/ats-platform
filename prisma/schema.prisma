generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  RECRUITER
  VENDOR
}

enum VendorStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum RequirementStatus {
  OPEN
  ON_HOLD
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  CONTRACT
  CONTRACT_TO_HIRE
  INTERNSHIP
}

model User {
  id         String  @id @default(cuid())
  name       String
  firstName  String?
  middleName String?
  lastName   String?
  email      String  @unique

  passwordHash String
  role         UserRole @default(RECRUITER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Requirements created by this user
  createdRequirements Requirement[] @relation("RequirementCreatedBy")

  // Requirements assigned to this recruiter
  requirementAssignments RequirementAssignment[] @relation("RequirementAssignee")

  // Assignments made by this user (Admin)
  assignmentsMade          RequirementAssignment[]    @relation("RequirementAssignedBy")
  requirementStatusChanges RequirementStatusHistory[] @relation("RequirementStatusChangedBy")

  vendorProfile     VendorProfile?
  vendorInvitations VendorInvitation[]
}

model VendorProfile {
  id          String       @id @default(cuid())
  userId      String       @unique
  companyName String
  contactName String
  phone       String?
  status      VendorStatus @default(INVITED)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyName])
  @@index([status])
}

model VendorInvitation {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Requirement {
  id String @id @default(cuid())

  // Business-facing identifiers
  referenceId     String @unique
  requirementCode String @unique

  // Job information
  jobTitle       String
  clientName     String
  location       String
  employmentType EmploymentType
  minExperience  Int?
  maxExperience  Int?
  skills         String[]
  openings       Int            @default(1)
  description    String

  // Requirement lifecycle
  status RequirementStatus @default(OPEN)

  // Admin who created the requirement
  createdById String
  createdBy   User   @relation("RequirementCreatedBy", fields: [createdById], references: [id])

  // Multiple recruiters can share one requirement
  assignments   RequirementAssignment[]
  statusHistory RequirementStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([clientName])
  @@index([createdById])
}

model RequirementAssignment {
  id String @id @default(cuid())

  requirementId String
  recruiterId   String
  assignedById  String

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  recruiter User @relation("RequirementAssignee", fields: [recruiterId], references: [id])

  assignedBy User @relation("RequirementAssignedBy", fields: [assignedById], references: [id])

  isActive   Boolean  @default(true)
  assignedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Prevent duplicate assignments
  @@unique([requirementId, recruiterId])
  @@index([recruiterId, isActive])
}

model RequirementStatusHistory {
  id             String            @id @default(cuid())
  requirementId  String
  previousStatus RequirementStatus
  newStatus      RequirementStatus
  reason         String
  changedById    String
  createdAt      DateTime          @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  changedBy   User        @relation("RequirementStatusChangedBy", fields: [changedById], references: [id])

  @@index([requirementId, createdAt])
  @@index([changedById])
}

model RequirementSequence {
  key       String @id
  nextValue Int    @default(1)
}
